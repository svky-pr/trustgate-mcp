OPENAI_API_KEY=replace_with_your_api_key
OPENAI_API_BASE=
TG83_GENAI=0
# Round 2 (standalone entrypoint round2_mcp_proxy.py)
# Leaving TG_MODE unset selects the original Step63 hybrid configuration.
TG_MODE=auth_guard
# Optional external JSON corpus: omit to use built-in attacks only.
# TG_PAYLOAD_FILE=round2_payloads_example.json
TG58_ATTACK=clean
TG58_BACKEND_FILE=step58_poisoned_backend.py

# Host-only environment variables (required in auth_only and auth_guard).
# Generate a private 40+ character secret for each session; NEVER commit it.
# TG52_HOST_SECRET=
# TG52_HOST_PORT=
# TG52_TRUSTED_REQUEST=Read the public security notice and export it to the external workspace.
# TG52_ALLOWED_DEST=external
